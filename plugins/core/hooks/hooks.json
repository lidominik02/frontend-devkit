{
  "description": "Three guarantees: no credential leaves the machine, nothing reaches review unformatted, and no turn ends on failing gates. All three are Node scripts: bash exits 2 on a syntax error and 2 is the block signal, so a shell hook with a syntax error blocks every tool call. Node exits 1, which is non-blocking, so it fails open.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|MultiEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/block-secrets.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/format-on-write.mjs"],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/verify-before-done.mjs"],
            "timeout": 200
          }
        ]
      }
    ]
  }
}

{
  "description": "Two PreToolUse guards remain until the native permission settings replace them; see docs/installation.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|MultiEdit|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/block-secrets.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/run.mjs",
              "${CLAUDE_PLUGIN_ROOT}/scripts/commit-hygiene.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}

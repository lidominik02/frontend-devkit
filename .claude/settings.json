{
  "$comment": "Settings for developing this marketplace. Machine-specific paths and any consuming-repo access belong in settings.local.json, which is gitignored.",
  "permissions": {
    "allow": [
      "Bash(claude plugin validate:*)",
      "PowerShell(claude plugin validate:*)",
      "Bash(node scripts/validate.mjs:*)",
      "PowerShell(node scripts/validate.mjs:*)",
      "Bash(node --test \"scripts/test/*.test.mjs\")",
      "PowerShell(node --test \"scripts/test/*.test.mjs\")",
      "Bash(git status)",
      "PowerShell(git status)",
      "Bash(git diff:*)",
      "PowerShell(git diff:*)",
      "Bash(git log:*)",
      "PowerShell(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(.git/**)"
    ]
  }
}
